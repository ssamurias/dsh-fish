{
  "name": "@ssamurias/dsh-fish",
  "version": "1.1.0",
  "description": "养一条会自己长大的鱼：没有人格设置，通过事件流长大。她可以自己刷 B 站、会写日记给你看，四个阶段完成后才会开始有立场。状态库在 ~/.dsh-fish，不能删除记录。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "lib",
    "media",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "RELEASE-NOTES-*.md",
    "scripts",
    "tools"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "unknown",
        "0.2.1-rc.1": "unknown",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.4": "unknown",
        "0.2.1-rc.5": "unknown",
        "0.2.2-alpha.2": "unknown",
        "0.2.2-rc.1": "unknown"
      },
      "profiles": [
        "desktop",
        "web",
        "headless"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "pet"
  ],
  "author": "ssamurias",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssamurias/dsh-fish.git"
  },
  "homepage": "https://github.com/ssamurias/dsh-fish#readme",
  "bugs": {
    "url": "https://github.com/ssamurias/dsh-fish/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {}
}
